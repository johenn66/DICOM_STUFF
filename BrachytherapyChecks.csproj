<?xml version="1.0" encoding="utf-8"?>
<!--
  BrachytherapyChecks.csproj
  Eclipse ESAPI v15.6 — GYN HDR Catheter & Dwell QA Check
  Plugin script: builds as a class library DLL loaded by Eclipse Script Wizard.

  SETUP INSTRUCTIONS
  ==================
  1. Install Eclipse 15.6 on the build machine.
  2. Confirm the ESAPI DLLs exist at the paths below (update HintPath if needed).
  3. Open this project in Visual Studio 2019+ and build in Release mode.
  4. Copy BrachytherapyChecks.dll and GynHdrTolerances.xml to the same folder.
  5. In Eclipse: Scripting → Run → browse to BrachytherapyChecks.dll.

  Default ESAPI DLL locations (Eclipse 15.6)
  ===========================================
  C:\Program Files\Varian\RTM\15.6\esapi\API\VMS.TPS.Common.Model.API.dll
  C:\Program Files\Varian\RTM\15.6\esapi\API\VMS.TPS.Common.Model.Types.dll
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Plugin scripts must be class libraries, not executables -->
    <OutputType>Library</OutputType>
    <!-- ESAPI 15.6 requires .NET Framework 4.6.1 -->
    <TargetFramework>net461</TargetFramework>
    <AssemblyName>BrachytherapyChecks</AssemblyName>
    <RootNamespace>VMS.TPS</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- ========================================================================
       ESAPI 15.6 references
       Update HintPath values if Eclipse is installed to a non-default location.
  ======================================================================== -->
  <ItemGroup>
    <Reference Include="VMS.TPS.Common.Model.API">
      <HintPath>C:\Program Files\Varian\RTM\15.6\esapi\API\VMS.TPS.Common.Model.API.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="VMS.TPS.Common.Model.Types">
      <HintPath>C:\Program Files\Varian\RTM\15.6\esapi\API\VMS.TPS.Common.Model.Types.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- WPF assemblies for the results window -->
    <Reference Include="PresentationFramework" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />

    <!-- BCL -->
    <Reference Include="System" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>

</Project>
