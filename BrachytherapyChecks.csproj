<?xml version="1.0" encoding="utf-8"?>
<!--
  BrachytherapyChecks.csproj
  Visual Studio / MSBuild project for the Eclipse ESAPI v15.6 brachytherapy
  plan-check script.

  SETUP INSTRUCTIONS
  ==================
  1. Install Eclipse 15.6 (Varian) on the build machine.
  2. Verify that the ESAPI DLLs exist at the paths listed under <Reference>.
     The default Varian installation path is used below; update if needed.
  3. Open this project in Visual Studio 2019+ and build in Release mode.
  4. Run the resulting EXE on the Eclipse workstation (or via a VPN/terminal
     with Eclipse write-access).

  ESAPI DLL default locations (Eclipse 15.6)
  ===========================================
  C:\Program Files\Varian\RTM\15.6\esapi\API\VMS.TPS.Common.Model.API.dll
  C:\Program Files\Varian\RTM\15.6\esapi\API\VMS.TPS.Common.Model.Types.dll
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- ESAPI 15.6 requires .NET Framework 4.6.1 -->
    <TargetFramework>net461</TargetFramework>
    <AssemblyName>BrachytherapyChecks</AssemblyName>
    <RootNamespace>BrachytherapyChecks</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- ========================================================================
       ESAPI 15.6 references
       Update the HintPath values if Eclipse is installed to a non-default
       location on your workstation.
  ======================================================================== -->
  <ItemGroup>
    <Reference Include="VMS.TPS.Common.Model.API">
      <HintPath>C:\Program Files\Varian\RTM\15.6\esapi\API\VMS.TPS.Common.Model.API.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="VMS.TPS.Common.Model.Types">
      <HintPath>C:\Program Files\Varian\RTM\15.6\esapi\API\VMS.TPS.Common.Model.Types.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- PresentationFramework is needed for the [STAThread] window model used
         by ESAPI (WPF dispatcher). -->
    <Reference Include="PresentationFramework" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Linq" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="BrachytherapyChecks.cs" />
  </ItemGroup>

</Project>
